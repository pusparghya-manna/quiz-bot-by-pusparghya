PORT=3000
NODE_ENV=production

# Required
TELEGRAM_BOT_TOKEN=
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
GEMINI_API_KEY=
JWT_SECRET=

# Optional
GEMINI_MODEL=gemini-flash-latest
ALLOWED_ORIGINS=https://quiz-bot-by-pusparghya.vercel.app,http://localhost:5173
MAX_OCR_BASE64_CHARS=10000000
MAX_MESSAGE_LENGTH=3500

# Optional seed teacher (never commit real values)
TEACHER_USERNAME=
TEACHER_PASSWORD=
TEACHER_NAME=

# Dangerous: allows POST /api/reseed and /api/seed
ENABLE_RESEED=false
