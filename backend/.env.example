# Required in production
PORT=3000
JWT_SECRET=change-me-to-a-long-random-string-24chars-min
TURSO_DATABASE_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=
TELEGRAM_BOT_TOKEN=

# Recommended
ALLOWED_ORIGINS=https://quizbot.pusparghya.de5.net,https://quiz-bot-by-pusparghya.vercel.app,https://quiz-bot-webapp-tg.vercel.app
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_POLLING_ENABLED=true
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Optional teacher seed
TEACHER_USERNAME=
TEACHER_PASSWORD=
TEACHER_NAME=
ENABLE_RESEED=false

# Firebase teacher authentication (enable after setting all four values)
FIREBASE_AUTH_ENABLED=false
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_WEB_API_KEY=

# Private channel/chat ID where the bot stores question diagram photos (bot must be admin)
TELEGRAM_MEDIA_STORAGE_CHAT_ID=
