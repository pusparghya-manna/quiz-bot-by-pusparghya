{
  "installCommand": "cd frontend && npm ci --registry=https://registry.npmjs.org",
  "buildCommand": "cd frontend && npm run build",
  "outputDirectory": "frontend/dist",
  "framework": null,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://quiz-bot-by-pusparghya-production.up.railway.app/api/:path*"
    },
    {
      "source": "/health",
      "destination": "https://quiz-bot-by-pusparghya-production.up.railway.app/health"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
