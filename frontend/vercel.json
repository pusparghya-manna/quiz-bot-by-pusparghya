{
  "installCommand": "npm ci --registry=https://registry.npmjs.org",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://quiz-bot-by-pusparghya-production.up.railway.app/api/:path*"
    },
    {
      "source": "/health",
      "destination": "https://quiz-bot-by-pusparghya-production.up.railway.app/health"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
